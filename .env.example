# ============================================================================
# ตัวอย่างการตั้งค่า Environment Variables สำหรับ Supabase Edge Function (Server-Side)
# หมายเหตุ: ไฟล์นี้ใช้เป็นตัวอย่างเท่านั้น ห้ามใส่ API Key จริงและห้าม Commit ไฟล์ .env จริงขึ้น GitHub
# การตั้งค่าจริงบน Supabase ให้ใช้คำสั่ง:
#   supabase secrets set GEMINI_API_KEY="YOUR_REAL_GEMINI_API_KEY"
#   supabase secrets set GEMINI_MODEL="gemini-2.5-flash"
#   supabase secrets set ALLOWED_ORIGIN="https://your-username.github.io"
# ============================================================================

# Gemini API Key (เก็บเฉพาะฝั่ง Server ใน Supabase Edge Function Secrets เท่านั้น)
GEMINI_API_KEY=AIzaSy_PLACEHOLDER_DO_NOT_USE_REAL_KEY_HERE

# Gemini Model ID (สามารถเปลี่ยนรุ่นในอนาคตได้โดยไม่ต้องแก้ไขโค้ด Frontend)
GEMINI_MODEL=gemini-2.5-flash

# โดเมนที่อนุญาตให้เรียก Edge Function (เช่น https://username.github.io หรือ http://127.0.0.1:8080 สำหรับทดสอบในเครื่อง)
ALLOWED_ORIGIN=http://127.0.0.1:8080

# ขีดจำกัดการวิเคราะห์ภาพด้วย AI ต่อผู้ใช้ต่อชั่วโมง
AI_RATE_LIMIT_PER_HOUR=20

# พอร์ตสำหรับรัน Static Server ทดสอบในเครื่อง (Local Development)
PORT=8080
HOST=127.0.0.1
